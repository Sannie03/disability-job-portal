# Copy to backend/.env for local development. Put real production values in Render.
NODE_ENV=development
PORT=5000
DB_URL=mongodb://127.0.0.1:27017/Job_Portal
JWT_SECRET_KEY=
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
COOKIE_SAME_SITE=lax
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
# Same independent random secret (32+ bytes) in backend and ASL; never in VITE_*.
ASL_TOKEN_SECRET=
